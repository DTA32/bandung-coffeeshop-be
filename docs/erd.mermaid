---
title: Entity Relationship Diagram
---

erDiagram
    Location {
        text id PK
        text name
        text description
        text description_indo
        text gmaps_id
        enum type
        %%"cafe", "poi", "area", "district"%%
        enum status
        %%"active", "closed", "deleted"%%
        geometry coordinates
        timestamp created_at
        timestamp updated_at
    }

    LocationImage {
        int id PK
        text location_id FK
        text url
        text description
        text description_indo
        int display_order
        timestamp created_at
        timestamp updated_at
    }

    Cafe {
        int id PK
        text location_id FK "unique"
        text instagram
        boolean is_featured
        text[] weather "subset of clear|cloudy|rain"
        text phone
        text menu
        text description "about blurb"
        text description_indo
        timestamp created_at
        timestamp updated_at
    }

    CafeHour {
        int id PK
        int cafe_id FK "on delete cascade"
        enum day "null = every day"
        %%"mon", "tue", "wed", "thu", "fri", "sat", "sun"%%
        time open_hour
        time close_hour "< open_hour = overnight"
        date valid_from "null on both = regular hours"
        date valid_until "inclusive"
        boolean close "closed that day"
        timestamp created_at
        timestamp updated_at
    }

    CafeFeed {
        int id PK
        int cafe_id FK
        text content
        text[] images
        text author "default Admin"
        text link
        timestamp published_at
        timestamp expires_at
        boolean visible
        timestamp created_at
        timestamp updated_at
    }

    SourceTarget {
        int cafe_id PK,FK
        enum source PK
        %%"gmaps", "instagram", "linktree"%%
        text external_id
        boolean enabled
        timestamp last_success_at
        text last_error
        int consecutive_failures
        timestamp created_at
        timestamp updated_at
    }

    SourceSnapshot {
        bigint id PK
        int cafe_id FK
        enum source
        timestamp fetched_at
        jsonb raw
        jsonb parsed
        text hash
    }

    ChangeProposal {
        bigint id PK
        int cafe_id FK
        enum source
        text field
        text item_key "'' or ig shortcode"
        jsonb old_value
        jsonb new_value
        text evidence_url
        bigint snapshot_id FK
        enum status
        %%"pending", "approved", "rejected", "superseded"%%
        jsonb resolved_value
        timestamp created_at
        timestamp resolved_at
    }

    ScrapeRun {
        bigint id PK
        enum source
        timestamp started_at
        timestamp finished_at
        int ok
        int failed
        int proposals
        text error
    }

    CafeReview {
        int id PK
        int cafe_id FK "unique (cafe_id, user_id) where status <> deleted"
        int user_id FK "null = partnership review"
        text reviewer_name
        enum status
        %%"pending", "approved", "rejected", "deleted"%%
        boolean is_pinned
        decimal overall_score
        decimal wfc_score
        text content
        text external_url_title
        text external_url_link
        date visited_at "first of month"
        timestamp created_at
        timestamp updated_at
    }

    Tag {
        int id PK
        text name
        text name_indo
        text description
        text description_indo
        text slug
        timestamp created_at
        timestamp updated_at
    }

    CafeTag {
        int cafe_id PK,FK
        int tag_id PK,FK
        boolean visible
        timestamp created_at
        timestamp updated_at
    }

    CafePrice {
        int id PK
        int cafe_id FK "unique"
        int price_range_min
        int price_range_max
        int coffee_price_min
        int coffee_price_max
        int snack_price_min
        int snack_price_max
        int food_price_min
        int food_price_max
        timestamp created_at
        timestamp updated_at
    }

    RatingTypeLabel {
        text type PK
        %%"price-rank", "vibe", "noise", "wifi", "meals", "atmosphere", "parking"%%
        text label
        text label_indo
    }

    RatingCategory {
        int id PK
        text name
        text name_indo
        text short_description
        text short_description_indo
        text long_description
        text long_description_indo
        text slug
        text type FK
        decimal lower_bound
        decimal upper_bound
        timestamp created_at
        timestamp updated_at
    }

    CafeRating {
        int id PK
        int cafe_id FK
        int review_id FK "unique (review_id, category_type)"
        text category_type FK
        decimal score
        text short_description_override
        text short_description_override_indo
        timestamp created_at
        timestamp updated_at
    }

    Users {
        int id PK
        text provider "unique (provider, provider_sub)"
        text provider_sub
        text email
        text name
        text avatar_url
        enum status
        %%"active", "deleted"%%
        timestamp created_at
        timestamp updated_at
    }

    Location ||--o| Cafe : "is"
    Location ||--o{ LocationImage : "has"
    Cafe ||--o{ CafeReview : "has"
    Cafe ||--o| CafePrice : "has"
    Cafe ||--o{ CafeRating : "has"
    CafeReview ||--o{ CafeRating : "scores"
    Users |o--o{ CafeReview : "writes"
    Cafe ||--o{ CafeTag : "has"
    Tag ||--o{ CafeTag : "has"
    RatingTypeLabel ||--o{ RatingCategory : "labels"
    RatingTypeLabel ||--o{ CafeRating : "types"
    Cafe ||--o{ CafeHour : "opens"
    Cafe ||--o{ CafeFeed : "has"
    Cafe ||--o{ SourceTarget : "scraped by"
    Cafe ||--o{ SourceSnapshot : "has"
    Cafe ||--o{ ChangeProposal : "has"
    SourceSnapshot |o--o{ ChangeProposal : "evidence"
