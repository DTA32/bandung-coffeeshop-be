APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=bandung_coffeeshop
# Redis cache; leave REDIS_HOST empty to run without a cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# weatherapi.com key for "Match the weather"; leave empty to disable
WEATHERAPI_KEY=
# Google sign-in (BCF-25); leave GOOGLE_CLIENT_ID/SECRET empty to disable auth
# routes (they answer 503). Auth also needs Redis for sessions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin the browser sees; post-login redirects are absolute against it
PUBLIC_BASE_URL=http://localhost:3000
# OAuth redirect URI registered with Google; defaults to
# ${PUBLIC_BASE_URL}/api/v1/auth/google/callback (behind the /api rewrite)
AUTH_CALLBACK_URL=http://localhost:8080/v1/auth/google/callback
# Comma-separated CORS origins (credentials allowed); also gates POST/PUT/DELETE
ALLOWED_ORIGINS=http://localhost:3000
# Secure flag on auth cookies; set false for plain-http local dev
COOKIE_SECURE=false
